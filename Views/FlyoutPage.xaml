<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TrayQr.Views.FlyoutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TrayQr.Views"
    Background="Transparent"
    NavigationCacheMode="Required">

    <Grid Padding="16,12,12,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Grid ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <SelectorBar x:Name="ModeSelector" SelectionChanged="ModeSelector_SelectionChanged">
                <SelectorBarItem
                    x:Name="CreateItem"
                    IsSelected="True"
                    Text="Create">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xED14;" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
                <SelectorBarItem x:Name="ReadItem" Text="Read">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xE722;" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
            </SelectorBar>
            <Button
                Grid.Column="1"
                VerticalAlignment="Center"
                AutomationProperties.Name="Settings"
                Click="SettingsButton_Click"
                Style="{StaticResource FlyoutIconButtonStyle}"
                ToolTipService.ToolTip="Settings">
                <FontIcon FontSize="14" Glyph="&#xE713;" />
            </Button>
        </Grid>

        <!--  Create  -->
        <Grid
            x:Name="CreatePanel"
            Grid.Row="1"
            RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBox
                x:Name="InputBox"
                MaxHeight="96"
                AcceptsReturn="True"
                AutomationProperties.Name="Text to encode"
                PlaceholderText="Type text or paste a link"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                TextChanged="InputBox_TextChanged"
                TextWrapping="Wrap" />

            <!--  QR codes stay black on white in both themes so every scanner can read them.  -->
            <Border
                Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="White"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid Width="232" Height="232">
                    <Image
                        x:Name="QrImage"
                        AutomationProperties.Name="QR code"
                        Stretch="Uniform" />
                    <TextBlock
                        x:Name="QrPlaceholder"
                        Margin="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="#8A000000"
                        Text="Your QR code will appear here"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </Grid>
            </Border>

            <Grid Grid.Row="2" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox
                    x:Name="ErrorCorrectionBox"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Error correction"
                    SelectionChanged="ErrorCorrectionBox_SelectionChanged"
                    ToolTipService.ToolTip="Error correction: higher levels survive more damage but make a denser code">
                    <x:String>Low (7%)</x:String>
                    <x:String>Medium (15%)</x:String>
                    <x:String>Quartile (25%)</x:String>
                    <x:String>High (30%)</x:String>
                </ComboBox>
                <Button
                    x:Name="CopyImageButton"
                    Grid.Column="1"
                    AutomationProperties.Name="Copy image"
                    Click="CopyImageButton_Click"
                    IsEnabled="False"
                    ToolTipService.ToolTip="Copy image">
                    <FontIcon FontSize="16" Glyph="&#xE8C8;" />
                </Button>
                <Button
                    x:Name="SaveImageButton"
                    Grid.Column="2"
                    AutomationProperties.Name="Save as PNG"
                    Click="SaveImageButton_Click"
                    IsEnabled="False"
                    ToolTipService.ToolTip="Save as PNG">
                    <FontIcon FontSize="16" Glyph="&#xE74E;" />
                </Button>
            </Grid>
        </Grid>

        <!--  Read  -->
        <Grid
            x:Name="ReadPanel"
            Grid.Row="1"
            RowSpacing="12"
            Visibility="Collapsed">
            <!--  Only active while this panel is visible, so Ctrl+V in the Create text box still pastes text.  -->
            <Grid.KeyboardAccelerators>
                <KeyboardAccelerator
                    Key="V"
                    Invoked="Paste_Invoked"
                    Modifiers="Control" />
            </Grid.KeyboardAccelerators>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border
                x:Name="DropZone"
                Height="148"
                AllowDrop="True"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                DragLeave="DropZone_DragLeave"
                DragOver="DropZone_DragOver"
                Drop="DropZone_Drop">
                <Grid>
                    <Image
                        x:Name="SourceImage"
                        Margin="8"
                        AutomationProperties.Name="Scanned image"
                        Stretch="Uniform" />
                    <StackPanel
                        x:Name="DropHint"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="6">
                        <FontIcon
                            FontSize="28"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xEB9F;" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Drop an image or press Ctrl+V"
                            TextAlignment="Center" />
                    </StackPanel>
                    <Border
                        x:Name="DropHighlight"
                        Margin="-1"
                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                        BorderThickness="2"
                        CornerRadius="8"
                        Visibility="Collapsed" />
                </Grid>
            </Border>

            <Grid Grid.Row="1" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    HorizontalAlignment="Stretch"
                    Click="ScanScreenButton_Click"
                    ToolTipService.ToolTip="Snip part of the screen and read the codes in it">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xF406;" />
                        <TextBlock Text="Screen" />
                    </StackPanel>
                </Button>
                <Button
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    Click="PasteButton_Click"
                    ToolTipService.ToolTip="Read an image from the clipboard (Ctrl+V)">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE77F;" />
                        <TextBlock Text="Paste" />
                    </StackPanel>
                </Button>
                <Button
                    Grid.Column="2"
                    HorizontalAlignment="Stretch"
                    Click="OpenFileButton_Click"
                    ToolTipService.ToolTip="Open an image file">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE8E5;" />
                        <TextBlock Text="Open" />
                    </StackPanel>
                </Button>
            </Grid>

            <Grid Grid.Row="2">
                <TextBlock
                    x:Name="ReadStatusText"
                    Margin="4,0"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Codes found in the image appear here."
                    TextWrapping="Wrap" />
                <ProgressRing
                    x:Name="ReadingRing"
                    Width="24"
                    Height="24"
                    VerticalAlignment="Top"
                    IsActive="False" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ResultsList">
                        <ItemsControl.ItemContainerTransitions>
                            <TransitionCollection>
                                <EntranceThemeTransition IsStaggeringEnabled="True" />
                            </TransitionCollection>
                        </ItemsControl.ItemContainerTransitions>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:ScanResult">
                                <Border
                                    Margin="0,0,0,8"
                                    Padding="12"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <StackPanel Spacing="8">
                                        <TextBox
                                            MaxHeight="120"
                                            AutomationProperties.Name="Decoded text"
                                            IsReadOnly="True"
                                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                                            Text="{x:Bind Text}"
                                            TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button
                                                Click="OpenResult_Click"
                                                Content="Open"
                                                Style="{StaticResource AccentButtonStyle}"
                                                ToolTipService.ToolTip="{x:Bind Link}"
                                                Visibility="{x:Bind LinkVisibility}" />
                                            <Button Click="CopyResult_Click" Content="Copy text" />
                                            <Button Click="EditResult_Click" Content="Make new code" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Page>
