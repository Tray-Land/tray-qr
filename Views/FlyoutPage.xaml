<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TrayQr.Views.FlyoutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TrayQr.Views"
    Background="Transparent"
    NavigationCacheMode="Required">

    <Page.Resources>
        <!--  One decoded code, shared by the Read and Camera tabs.  -->
        <DataTemplate x:Key="ScanResultTemplate" x:DataType="local:ScanResult">
            <Border
                Margin="0,0,0,8"
                Padding="12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="8">
                    <TextBox
                        MaxHeight="120"
                        AutomationProperties.Name="Decoded text"
                        IsReadOnly="True"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        Text="{x:Bind Text}"
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            Click="OpenResult_Click"
                            Content="Open"
                            Style="{StaticResource AccentButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind Link}"
                            Visibility="{x:Bind LinkVisibility}" />
                        <Button Click="CopyResult_Click" Content="Copy text" />
                        <Button Click="EditResult_Click" Content="Make new code" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="16,12,12,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Grid ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <SelectorBar x:Name="ModeSelector" SelectionChanged="ModeSelector_SelectionChanged">
                <SelectorBarItem
                    x:Name="CreateItem"
                    IsSelected="True"
                    Text="Create">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xED14;" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
                <SelectorBarItem x:Name="ReadItem" Text="Read">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xE722;" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
                <SelectorBarItem x:Name="CameraItem" Text="Camera">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xE714;" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
            </SelectorBar>
            <Button
                Grid.Column="1"
                VerticalAlignment="Center"
                AutomationProperties.Name="Settings"
                Click="SettingsButton_Click"
                Style="{StaticResource FlyoutIconButtonStyle}"
                ToolTipService.ToolTip="Settings">
                <FontIcon FontSize="14" Glyph="&#xE713;" />
            </Button>
        </Grid>

        <!--  Create  -->
        <Grid
            x:Name="CreatePanel"
            Grid.Row="1"
            RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBox
                x:Name="InputBox"
                MaxHeight="96"
                AcceptsReturn="True"
                AutomationProperties.Name="Text to encode"
                PlaceholderText="Type text or paste a link"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                TextChanged="InputBox_TextChanged"
                TextWrapping="Wrap" />

            <!--  No frame of its own: the code's quiet zone is its border, and the corner radius rounds it.  -->
            <Border
                Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                CornerRadius="8">
                <Grid Width="232" Height="232">
                    <Image
                        x:Name="QrImage"
                        AutomationProperties.Name="QR code"
                        DragStarting="QrImage_DragStarting"
                        Stretch="Uniform" />
                    <FontIcon
                        x:Name="QrPlaceholderIcon"
                        AutomationProperties.Name="Your QR code will appear here"
                        FontSize="120"
                        Foreground="{ThemeResource TextFillColorDisabledBrush}"
                        Glyph="&#xED14;" />
                    <TextBlock
                        x:Name="TooLongMessage"
                        Margin="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Too much text for a QR code. Shorten it or lower the error correction."
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                </Grid>
            </Border>

            <StackPanel
                x:Name="LowContrastWarning"
                Grid.Row="2"
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="6"
                Visibility="Collapsed">
                <FontIcon
                    FontSize="14"
                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                    Glyph="&#xE7BA;" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Low contrast: some scanners may not read this code" />
            </StackPanel>

            <Grid Grid.Row="3" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="ForegroundButton"
                    Width="48"
                    AutomationProperties.Name="Code color"
                    ToolTipService.ToolTip="Code color">
                    <Viewbox Width="18" Height="18">
                        <FontIcon x:Name="ForegroundSwatch" Glyph="&#xED14;" />
                    </Viewbox>
                    <Button.Flyout>
                        <Flyout Closed="ColorFlyout_Closed" Placement="LeftEdgeAlignedBottom" ShouldConstrainToRootBounds="False">
                            <StackPanel Spacing="8">
                                <ColorPicker
                                    x:Name="ForegroundPicker"
                                    AutomationProperties.Name="Code color"
                                    ColorChanged="ColorPicker_ColorChanged"
                                    ColorSpectrumShape="Box"
                                    IsAlphaEnabled="False"
                                    IsColorChannelTextInputVisible="False"
                                    IsColorPreviewVisible="False"
                                    IsMoreButtonVisible="False" />
                                <Button
                                    HorizontalAlignment="Stretch"
                                    Click="ResetColors_Click"
                                    Content="Reset to black on white" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button
                    x:Name="BackgroundButton"
                    Grid.Column="1"
                    Width="48"
                    AutomationProperties.Name="Background color"
                    ToolTipService.ToolTip="Background color">
                    <!--  The stroke keeps a white square visible on the light theme's button.  -->
                    <Rectangle
                        x:Name="BackgroundSwatch"
                        Width="16"
                        Height="16"
                        Stroke="{ThemeResource ControlStrokeColorDefaultBrush}"
                        StrokeThickness="1" />
                    <Button.Flyout>
                        <Flyout Closed="ColorFlyout_Closed" Placement="LeftEdgeAlignedBottom" ShouldConstrainToRootBounds="False">
                            <StackPanel Spacing="8">
                                <ColorPicker
                                    x:Name="BackgroundPicker"
                                    AutomationProperties.Name="Background color"
                                    ColorChanged="ColorPicker_ColorChanged"
                                    ColorSpectrumShape="Box"
                                    IsAlphaEnabled="False"
                                    IsColorChannelTextInputVisible="False"
                                    IsColorPreviewVisible="False"
                                    IsMoreButtonVisible="False" />
                                <Button
                                    HorizontalAlignment="Stretch"
                                    Click="ResetColors_Click"
                                    Content="Reset to black on white" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <DropDownButton
                    x:Name="ErrorCorrectionButton"
                    Grid.Column="2"
                    AutomationProperties.Name="Error correction">
                    <TextBlock x:Name="ErrorCorrectionText" />
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="ErrorCorrectionMenu" Placement="Top" />
                    </DropDownButton.Flyout>
                </DropDownButton>
                <Button
                    x:Name="CopyImageButton"
                    Grid.Column="4"
                    AutomationProperties.Name="Copy image"
                    Click="CopyImageButton_Click"
                    IsEnabled="False"
                    ToolTipService.ToolTip="Copy image">
                    <FontIcon FontSize="16" Glyph="&#xE8C8;" />
                </Button>
                <Button
                    x:Name="SaveImageButton"
                    Grid.Column="5"
                    AutomationProperties.Name="Save as PNG"
                    Click="SaveImageButton_Click"
                    IsEnabled="False"
                    ToolTipService.ToolTip="Save as PNG">
                    <FontIcon FontSize="16" Glyph="&#xE74E;" />
                </Button>
            </Grid>
        </Grid>

        <!--  Read  -->
        <Grid
            x:Name="ReadPanel"
            Grid.Row="1"
            RowSpacing="12"
            Visibility="Collapsed">
            <!--  Only active while this panel is visible, so Ctrl+V in the Create text box still pastes text.  -->
            <Grid.KeyboardAccelerators>
                <KeyboardAccelerator
                    Key="V"
                    Invoked="Paste_Invoked"
                    Modifiers="Control" />
            </Grid.KeyboardAccelerators>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border
                x:Name="DropZone"
                Height="148"
                AllowDrop="True"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                DragLeave="DropZone_DragLeave"
                DragOver="DropZone_DragOver"
                Drop="DropZone_Drop">
                <Grid>
                    <Image
                        x:Name="SourceImage"
                        Margin="8"
                        AutomationProperties.Name="Scanned image"
                        Stretch="Uniform" />
                    <StackPanel
                        x:Name="DropHint"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="6">
                        <FontIcon
                            FontSize="28"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xEB9F;" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Drop an image or press Ctrl+V"
                            TextAlignment="Center" />
                    </StackPanel>
                    <Border
                        x:Name="DropHighlight"
                        Margin="-1"
                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                        BorderThickness="2"
                        CornerRadius="8"
                        Visibility="Collapsed" />
                </Grid>
            </Border>

            <Grid Grid.Row="1" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    HorizontalAlignment="Stretch"
                    Click="ScanScreenButton_Click"
                    ToolTipService.ToolTip="Snip part of the screen and read the codes in it">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xF406;" />
                        <TextBlock Text="Screen" />
                    </StackPanel>
                </Button>
                <Button
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    Click="PasteButton_Click"
                    ToolTipService.ToolTip="Read an image from the clipboard (Ctrl+V)">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE77F;" />
                        <TextBlock Text="Paste" />
                    </StackPanel>
                </Button>
                <Button
                    Grid.Column="2"
                    HorizontalAlignment="Stretch"
                    Click="OpenFileButton_Click"
                    ToolTipService.ToolTip="Open an image file">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE8E5;" />
                        <TextBlock Text="Open" />
                    </StackPanel>
                </Button>
            </Grid>

            <Grid Grid.Row="2">
                <TextBlock
                    x:Name="ReadStatusText"
                    Margin="4,0"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Codes found in the image appear here."
                    TextWrapping="Wrap" />
                <ProgressRing
                    x:Name="ReadingRing"
                    Width="24"
                    Height="24"
                    VerticalAlignment="Top"
                    IsActive="False" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ResultsList" ItemTemplate="{StaticResource ScanResultTemplate}">
                        <ItemsControl.ItemContainerTransitions>
                            <TransitionCollection>
                                <EntranceThemeTransition IsStaggeringEnabled="True" />
                            </TransitionCollection>
                        </ItemsControl.ItemContainerTransitions>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!--  Camera: realized on first use. The camera runs only while this tab is visible.  -->
        <Grid
            x:Name="CameraPanel"
            Grid.Row="1"
            x:Load="False"
            RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border
                Height="220"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <!--  Front cameras are mirrored, like a mirror and the Camera app.  -->
                    <Grid RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="CameraMirror" />
                        </Grid.RenderTransform>
                        <MediaPlayerElement
                            x:Name="CameraPreview"
                            AutomationProperties.Name="Camera preview"
                            Stretch="UniformToFill" />
                        <Image
                            x:Name="CameraSnapshot"
                            AutomationProperties.Name="Camera frame with the code"
                            Stretch="UniformToFill" />
                    </Grid>
                    <StackPanel
                        x:Name="CameraStatusPanel"
                        Margin="16"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="6"
                        Visibility="Collapsed">
                        <FontIcon
                            FontSize="28"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE714;" />
                        <TextBlock
                            x:Name="CameraStatusText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                        <HyperlinkButton
                            x:Name="PrivacySettingsLink"
                            HorizontalAlignment="Center"
                            Click="PrivacySettingsLink_Click"
                            Content="Open camera privacy settings"
                            Visibility="Collapsed" />
                    </StackPanel>
                    <ProgressRing
                        x:Name="CameraStartingRing"
                        Width="32"
                        Height="32"
                        IsActive="False" />
                </Grid>
            </Border>

            <Grid Grid.Row="1" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <DropDownButton
                    x:Name="CameraButton"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    AutomationProperties.Name="Camera"
                    ToolTipService.ToolTip="Choose a camera"
                    Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE714;" />
                        <TextBlock x:Name="CameraNameText" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="CameraMenu" Placement="Bottom" />
                    </DropDownButton.Flyout>
                </DropDownButton>
                <Button
                    x:Name="ScanAgainButton"
                    Grid.Column="1"
                    Click="ScanAgainButton_Click"
                    Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                        <TextBlock x:Name="ScanAgainText" Text="Scan again" />
                    </StackPanel>
                </Button>
            </Grid>

            <Grid Grid.Row="2">
                <TextBlock
                    x:Name="CameraHintText"
                    Margin="4,0"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Hold a QR code up to the camera."
                    TextWrapping="Wrap" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="CameraResultsList" ItemTemplate="{StaticResource ScanResultTemplate}">
                        <ItemsControl.ItemContainerTransitions>
                            <TransitionCollection>
                                <EntranceThemeTransition />
                            </TransitionCollection>
                        </ItemsControl.ItemContainerTransitions>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Page>
